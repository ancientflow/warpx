#全局定义
max_step = 5000000
my_constants.diag_num = 120
my_constants.reduced_diag_num = 12000
my_constants.dt = 3e-12

warpx.const_dt = dt
warpx.do_electrostatic = labframe
warpx.self_fields_required_precision = 1e-6
#warpx.self_fields_absolute_tolerance = 1e-3
warpx.sort_intervals = 25
warpx.use_filter = 0
warpx.grid_type = collocated

##几何参数定义
my_constants.L = 0.05
my_constants.l_factor = 5
my_constants.sim_L = L/l_factor
my_constants.lx = sim_L
my_constants.ly = sim_L
my_constants.lz = sim_L

#工况定义
my_constants.Ic = 0.5
my_constants.voltage = 300
my_constants.ifhole = 0


#粒子参数定义
my_constants.w_factor = 8
my_constants.elec_weight = 2.5e18*sim_L^3/64^3/200/w_factor

warpx.poisson_solver = multigrid

#几何
my_constants.factor = 4
my_constants.n_cell = 64 * factor

amr.n_cell = n_cell n_cell n_cell
amr.blocking_factor = n_cell
amr.max_grid_size = n_cell
amr.max_level = 0

#内存使用
amrex.the_arena_init_size = 1024*1024*1024*75 # 75GB内存

geometry.dims = 3
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = lx ly lz

#边界条件
boundary.field_lo = pec pec pec
boundary.field_hi = pec pec pec
boundary.particle_lo = absorbing absorbing absorbing
boundary.particle_hi = absorbing absorbing absorbing
boundary.potential_lo_x = 0
boundary.potential_lo_y = 0
boundary.potential_lo_z = 0
boundary.potential_hi_x = 0
boundary.potential_hi_y = 0
boundary.potential_hi_z = 0

# 斜阳极 Embedded Boundary
# r < a1 为中心通道；a1 <= r < b1 为圆锥侧面；
# r >= b1 为与圆锥连续的平面。隐式函数 > 0 为固体，< 0 为计算域。
my_constants.eb_x0 = lx / 2
my_constants.eb_y0 = ly / 2
my_constants.eb_a1 = 9.0e-3 / l_factor
my_constants.eb_b1 = 17.5e-3 / l_factor
my_constants.eb_delta_z = 7.5e-3 / l_factor
my_constants.eb_voltage_r_max = 13.0e-3 / l_factor
my_constants.eb_k = eb_delta_z / (eb_b1 - eb_a1)
my_constants.eb_b = eb_k * eb_b1 - eb_delta_z

warpx.eb_implicit_function = "if(sqrt((x-eb_x0)**2+(y-eb_y0)**2)<eb_a1,-1,if(sqrt((x-eb_x0)**2+(y-eb_y0)**2)<eb_b1,eb_k*sqrt((x-eb_x0)**2+(y-eb_y0)**2)-eb_k*eb_a1-z,eb_k*eb_b1-eb_b-z))"
warpx.eb_potential(x,y,z,t) = "if((sqrt((x-eb_x0)**2+(y-eb_y0)**2)>eb_a1) and (sqrt((x-eb_x0)**2+(y-eb_y0)**2)<eb_voltage_r_max),voltage,0)"

# 与中性原子解析圆锥法向共用同一组缩比后参数。
# 当前算例未设置中性物种，因此交互保持关闭。
insert.neutral_atom_eb.enabled = 0
insert.neutral_atom_eb.k = eb_k
insert.neutral_atom_eb.a1 = eb_a1
insert.neutral_atom_eb.b1 = eb_b1

#粒子设置
algo.particle_shape = 1

particles.species_names = electrons xe_ions

electrons.species_type = electron
#electrons.do_not_deposit = 1

xe_ions.species_type = xenon
xe_ions.charge = q_e
#xe_ions.do_not_deposit = 1

###重采样
electrons.save_particles_at_zlo = 1
electrons.ndt = 1

xe_ions.save_particles_at_xlo = 1
xe_ions.save_particles_at_xhi = 1
xe_ions.save_particles_at_ylo = 1
xe_ions.save_particles_at_yhi = 1
xe_ions.save_particles_at_zlo = 1
xe_ions.save_particles_at_zhi = 1
xe_ions.ndt = 10

my_constants.hall_diag_interval = 10
my_constants.thrust_diag_path = "thrust.dat"
my_constants.beam_divergence_path = "beam_divergence.dat"
my_constants.iedf_path = "iedf.dat"
