# 斜阳极 Embedded Boundary
# r < a1 为中心通道；a1 <= r < b1 为圆锥侧面；
# r >= b1 为与圆锥连续的平面。隐式函数 > 0 为固体，< 0 为计算域。
my_constants.eb_x0 = lx / 2
my_constants.eb_y0 = ly / 2
my_constants.eb_a1 = 9.0e-3 / l_factor
my_constants.eb_b1 = 17.5e-3 / l_factor
my_constants.eb_delta_z = 7.5e-3 / l_factor
my_constants.eb_voltage_r_max = 13.0e-3 / l_factor
my_constants.eb_k = eb_delta_z / (eb_b1 - eb_a1)
my_constants.eb_b = eb_k * eb_b1 - eb_delta_z

warpx.eb_implicit_function = "if(sqrt((x-eb_x0)**2+(y-eb_y0)**2)<eb_a1,-1,if(sqrt((x-eb_x0)**2+(y-eb_y0)**2)<eb_b1,eb_k*sqrt((x-eb_x0)**2+(y-eb_y0)**2)-eb_k*eb_a1-z,eb_k*eb_b1-eb_b-z))"
warpx.eb_potential(x,y,z,t) = "if((sqrt((x-eb_x0)**2+(y-eb_y0)**2)>eb_a1) and (sqrt((x-eb_x0)**2+(y-eb_y0)**2)<eb_voltage_r_max),voltage,0)"
insert.neutral_atom_eb.species = xe_netural
insert.neutral_atom_eb.wall_temperature = 400

# 与中性原子解析圆锥法向共用同一组缩比后参数。
# 旋转进气几何与中性原子壁面模型确认前，交互保持关闭。
insert.neutral_atom_eb.enabled = 1
insert.neutral_atom_eb.k = eb_k
insert.neutral_atom_eb.a1 = eb_a1
insert.neutral_atom_eb.b1 = eb_b1

#粒子设置
