collisions.collision_names =  elec_mcc_coll xe_coll xes_coll #elec_ion
collisions.split_position_push = 0
collisions.different_rho = 2
my_constants.mccndt = 2
my_constants.dsmcndt = 10
#所有碰撞：
# e + Xe -> e + Xe
# e + Xe -> e + Xe+ + e
# e + Xe -> e + Xe*
# Xe+ + Xe -> Xe+ + Xe
# Xe+ + Xe -> Xe + Xe+

#e / Xe 弹性、激发为MCC 其余DSMC
elec_mcc_coll.type = background_mcc
xes_coll.type = background_mcc
#elec_ion.type = background_mcc
xe_coll.type = background_mcc


# e- / Xe 弹性碰撞 激发碰撞 电离
elec_mcc_coll.scattering_processes = elastic excitation1 ionization
elec_mcc_coll.species = electrons
elec_mcc_coll.elastic_cross_section = Xe/XeElastic.dat
elec_mcc_coll.excitation1_energy = 8.315
elec_mcc_coll.excitation1_cross_section = Xe/XeExcitations.dat
elec_mcc_coll.ionization_energy = 12.1298
elec_mcc_coll.ionization_cross_section = Xe/XeIonization.dat
elec_mcc_coll.ionization_species = xe_ions
elec_mcc_coll.background_density = 2.5e18 #修改后不实际使用
elec_mcc_coll.background_temperature = 400
elec_mcc_coll.ground_species = xe_netural
elec_mcc_coll.excitation_product = xe_netural_s
elec_mcc_coll.have_excitation = 1
elec_mcc_coll.ndt = mccndt
elec_mcc_coll.ground_rho_index = 0
elec_mcc_coll.excitation_rho_index = 1

# e- / Xes 电离 退激发
xes_coll.scattering_processes = ionization
xes_coll.species = electrons
xes_coll.ionization_energy = 3.8
xes_coll.ionization_species = xe_ions
xes_coll.ionization_cross_section = Xe/XesIonization.dat
xes_coll.background_density = 2.5e18
xes_coll.background_temperature = 400
xes_coll.ground_species = xe_netural_s
xes_coll.have_excitation = 0
xes_coll.ndt = dsmcndt
xes_coll.ground_rho_index = 1

# Xe / Xe+ 电荷交换 弹性碰撞
xe_coll.scattering_processes = elastic elastic_back
xe_coll.species = xe_ions
xe_coll.elastic_cross_section = Xe/XeMomentumTransfer.dat
xe_coll.elastic_back_cross_section = Xe/XeChargeTransfer.dat
xe_coll.elastic_back_scattering_angle_model = backward
xe_coll.background_density = 2.5e18 #修改后不实际使用
xe_coll.background_temperature = 400
xe_coll.ground_species = xe_netural
xe_coll.ndt = dsmcndt
xe_coll.ground_rho_index = 0
xe_coll.have_excitation = 0