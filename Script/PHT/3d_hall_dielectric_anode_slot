#3d_hall_dielectric_slot_farfield 的一体化环缝进气版本：
#阳极边界显式开出一条连续环缝槽（缝宽 0.5mm 未缩比，环心位于原 48 孔环
#r_ring 上，槽深 slot_depth），缝底仍为阳极电位导体；中性气体在缝底以 slot_T
#半麦克斯韦通量注入，缝底与缝内/外侧壁对中性气体按 slot_T 漫反射热化，
#对离子中性化，对电子吸收。缝区壁面对中性气体全部反射（不吸收），稳态下
#进入通道的净流量自动等于 m_dot；缝内中性-中性 DSMC 与 e/Xe、Xe+/Xe 耦合
#MCC 按网格单元照常生效，无需改动。
#电势求解中环缝仍按阳极区域处理 (anode_implicit_function 范围不变,
#缝道内节点固定阳极电位), 环缝几何只对粒子壁面与注入生效:
#anode_ring 让开缝口, 新增 slot_bottom / slot_inner_wall / slot_outer_wall
#三面解析墙。
#全局定义
max_step = 10000000
my_constants.dt = 3e-12

warpx.const_dt = dt
warpx.do_electrostatic = labframe
warpx.self_fields_required_precision = 1e-5
warpx.self_fields_absolute_tolerance = 1
warpx.sort_intervals = 25
warpx.use_filter = 0
#Yee 网格: phi/rho 仍为节点存储, E 改为棱心紧模板差分 (等效 getGradSolution 通量形式)
warpx.grid_type = collocated
#关闭外源磁场的初始散度清洗: 文件未覆盖全域时清洗器会把 z=-2mm 钳制界面
#的跳变摊开并泄漏进通道 (z=-0.16mm 处 max|dBz|=0.15T); 不清洗时通道区离散
#散度仅 ~6e-4 相对量级, 误差集中在陶瓷内部钳制界面, 无粒子不受影响
warpx.do_initial_div_cleaning = 0

##几何参数定义
my_constants.L = 0.05
my_constants.l_factor = 5
my_constants.sim_L = L/l_factor
my_constants.lx = sim_L
my_constants.ly = sim_L
my_constants.lz = sim_L
my_constants.z_lo = -0.0025

#工况定义
my_constants.m_dot = 0.6e-6
my_constants.Ic = 0.5
my_constants.voltage = 300

# 环缝几何: 环心位于 r_ring 环上 (环心由 x_offset/y_offset 给定),
# 缝宽 0.5mm (未缩比), 做 l_factor 缩比
my_constants.r_ring = ((0.021 + 0.031) / 4) / l_factor
my_constants.slot_width = 0.5e-3 / l_factor
my_constants.slot_r_in = r_ring - slot_width / 2
my_constants.slot_r_out = r_ring + slot_width / 2

#粒子参数定义
my_constants.weight_ratio = 4
my_constants.w_factor = 8
my_constants.elec_weight = 2.5e18*sim_L^3/64^3/200/w_factor
my_constants.xe_weight = elec_weight*weight_ratio

#物质参数定义
my_constants.m_xe = 2.179e-25

warpx.poisson_solver = multigrid

#几何：z 方向向下扩展 2 mm，保持与横向接近的网格分辨率
amr.n_cell = 256 256 320
amr.blocking_factor = 64

amr.max_grid_size = 320
amr.max_level = 0

#内存使用
amrex.the_arena_init_size = 1024*1024*1024*75 # 75GB内存

geometry.dims = 3
geometry.prob_lo = 0.0 0.0 z_lo
geometry.prob_hi = lx ly lz

#边界条件
boundary.field_lo = pec pec pec
boundary.field_hi = pec pec pec
boundary.particle_lo = absorbing absorbing absorbing
boundary.particle_hi = absorbing absorbing absorbing
boundary.potential_lo_x = 0
boundary.potential_lo_y = 0
boundary.potential_lo_z = 0
boundary.potential_hi_x = 0
boundary.potential_hi_y = 0
boundary.potential_hi_z = 0

#陶瓷介质与体阳极
#原阳极环的内、外径分别为 21 mm 和 31 mm，并沿用 l_factor 缩放。
my_constants.ceramic_epsilon_r = 4.0
my_constants.anode_center_x = lx / 2
my_constants.anode_center_y = ly / 2
my_constants.anode_inner_radius = 0.021 / (2 * l_factor)
my_constants.anode_outer_radius = 0.031 / (2 * l_factor)
my_constants.anode_zmin = -0.00125
my_constants.anode_zmax = 0.0
my_constants.anode_voltage = voltage

# 环缝槽深 (模拟单位, 0.5mm 即未缩比 2.5mm) 与缝底位置;
# 缝底高于 anode_zmin, 仍属阳极导体; 缝区气体/壁面温度 (注入与热化共用)
my_constants.slot_depth = 0.5e-3
my_constants.z_slot_bottom = anode_zmax - slot_depth
my_constants.slot_T = 600.0

insert.use_electrostatic_materials = 1

#z < 0 为陶瓷。体阳极内部保持有限正介电常数，由 overset mask 排除其节点。
insert.relative_permittivity_function(x,y,z) = "if(z < 0.0, ceramic_epsilon_r, 1.0)"

#<= 0 表示体阳极：原环形阳极沿 z 负方向延伸 1 mm。
#电势求解中不扣除环缝缝道: 缝道区域仍按阳极处理 (节点 mask 为导体、
#固定阳极电位、内部 rho 置零), 环缝几何只对粒子壁面与注入生效。
insert.anode_implicit_function(x,y,z) = "if(((x-anode_center_x)**2 + (y-anode_center_y)**2 >= anode_inner_radius**2) * ((x-anode_center_x)**2 + (y-anode_center_y)**2 <= anode_outer_radius**2) * (z >= anode_zmin) * (z <= anode_zmax), -1.0, 1.0)"
insert.anode_potential_function(x,y,z) = "anode_voltage"

warpx.self_fields_phi_extrapolation_order = 2
warpx.self_fields_phi_extrapolation_alpha = 0.4
warpx.self_fields_phi_extrapolation_beta = 0.15

#粒子设置
algo.particle_shape = 1

particles.species_names = electrons xe_ions xe_neutral

electrons.species_type = electron

xe_ions.species_type = xenon
xe_ions.charge = q_e

xe_neutral.mass = m_xe
xe_neutral.charge = 1
xe_neutral.do_not_gather = 1
xe_neutral.do_not_deposit = 1

# 解析边界: z=0 阳极环面让开缝口, 其余陶瓷平面不变; 新增环缝的
# 缝底 (slot_bottom)、缝内侧壁 (slot_inner_wall)、缝外侧壁 (slot_outer_wall)。
# 各墙 signed_value < 0 的区域互不重叠; 棱边按 insert.analytic_walls 声明
# 顺序兜底: anode_ring/ceramic_wall 先处理 z=0 平面穿越, 缝侧壁用
# max(径向, z) 覆盖缝口以下全部深度, 消除槽底棱角的漏检。
insert.analytic_walls = anode_ring ceramic_wall slot_bottom slot_inner_wall slot_outer_wall

# 阳极环面: 仅覆盖缝口以外的两段环带 [anode_inner_radius, slot_r_in] 与
# [slot_r_out, anode_outer_radius], 法向 +z
analytic_wall.anode_ring.signed_value = "if(((((x-anode_center_x)**2 + (y-anode_center_y)**2 >= anode_inner_radius**2) * ((x-anode_center_x)**2 + (y-anode_center_y)**2 <= slot_r_in**2)) + (((x-anode_center_x)**2 + (y-anode_center_y)**2 >= slot_r_out**2) * ((x-anode_center_x)**2 + (y-anode_center_y)**2 <= anode_outer_radius**2))) > 0, z, 1.0)"
analytic_wall.anode_ring.normal_x = "0.0"
analytic_wall.anode_ring.normal_y = "0.0"
analytic_wall.anode_ring.normal_z = "1.0"

analytic_wall.ceramic_wall.signed_value = "if(min(((x-anode_center_x)**2 + (y-anode_center_y)**2) - anode_inner_radius**2, anode_outer_radius**2 - ((x-anode_center_x)**2 + (y-anode_center_y)**2)) < 0.0, z, 1.0)"
analytic_wall.ceramic_wall.normal_x = "0.0"
analytic_wall.ceramic_wall.normal_y = "0.0"
analytic_wall.ceramic_wall.normal_z = "1.0"

# 缝底: 缝区 (slot_r_in < r < slot_r_out) 内 z < z_slot_bottom 为墙后, 法向 +z
analytic_wall.slot_bottom.signed_value = "max(max(z - z_slot_bottom, slot_r_in**2 - ((x-anode_center_x)**2 + (y-anode_center_y)**2)), ((x-anode_center_x)**2 + (y-anode_center_y)**2) - slot_r_out**2)"
analytic_wall.slot_bottom.normal_x = "0.0"
analytic_wall.slot_bottom.normal_y = "0.0"
analytic_wall.slot_bottom.normal_z = "1.0"

# 缝内侧壁: r < slot_r_in 且 z < 0 为墙后, 法向沿 +r 指向缝道
analytic_wall.slot_inner_wall.signed_value = "max(sqrt((x-anode_center_x)**2 + (y-anode_center_y)**2) - slot_r_in, z)"
analytic_wall.slot_inner_wall.normal_x = "(x-anode_center_x)/sqrt((x-anode_center_x)**2 + (y-anode_center_y)**2)"
analytic_wall.slot_inner_wall.normal_y = "(y-anode_center_y)/sqrt((x-anode_center_x)**2 + (y-anode_center_y)**2)"
analytic_wall.slot_inner_wall.normal_z = "0.0"

# 缝外侧壁: r > slot_r_out 且 z < 0 为墙后, 法向沿 -r 指向缝道
analytic_wall.slot_outer_wall.signed_value = "max(slot_r_out - sqrt((x-anode_center_x)**2 + (y-anode_center_y)**2), z)"
analytic_wall.slot_outer_wall.normal_x = "-(x-anode_center_x)/sqrt((x-anode_center_x)**2 + (y-anode_center_y)**2)"
analytic_wall.slot_outer_wall.normal_y = "-(y-anode_center_y)/sqrt((x-anode_center_x)**2 + (y-anode_center_y)**2)"
analytic_wall.slot_outer_wall.normal_z = "0.0"

# 电子在阳极环上全吸收：不锈钢 Furman–Pivi 材料模型在高入射能量下
# 会因产额参数超出有效范围而中止 (Invalid stainless-steel wall impact)，
# 故退回通用路径的单一 absorb 行为 (唯一行为自动取全部概率)。
# 环缝三面壁同属阳极导体, 电子同样全吸收。
# 本算例删除壁面充电: 所有墙所有物种 deposit_wall_charge = 0。
electrons.analytic_wall.anode_ring.behaviors = absorb
electrons.analytic_wall.anode_ring.deposit_wall_charge = 0
electrons.analytic_wall.slot_bottom.behaviors = absorb
electrons.analytic_wall.slot_bottom.deposit_wall_charge = 0
electrons.analytic_wall.slot_inner_wall.behaviors = absorb
electrons.analytic_wall.slot_inner_wall.deposit_wall_charge = 0
electrons.analytic_wall.slot_outer_wall.behaviors = absorb
electrons.analytic_wall.slot_outer_wall.deposit_wall_charge = 0

# 陶瓷壁面: 删除二次电子发射 (SEE)。原陶瓷材料模型内含 SEE1/SEE2,
# 无法按参数关闭, 故改回通用 behaviors 路径: 吸收/镜面反射概率与陶瓷
# 模型一致, 原 SEE1 的剩余概率归入末尾的 absorb。原材料模型配置注释
# 保留如下, 便于恢复:
#electrons.analytic_wall.ceramic_wall.material = ceramic
#electrons.analytic_wall.ceramic_wall.secondary_electron_species = electrons
#electrons.analytic_wall.ceramic_wall.secondary_electron_temperature_eV = 3.0
electrons.analytic_wall.ceramic_wall.behaviors = absorb specular absorb
electrons.analytic_wall.ceramic_wall.p_absorb = "0.5*exp(-(E_eV/43.4592)**2)"
electrons.analytic_wall.ceramic_wall.p_specular = "0.5*exp(-(E_eV/30)**2)"
electrons.analytic_wall.ceramic_wall.deposit_wall_charge = 0

# 离子在两面均中性化；中性原子在两面均按 400 K 漫反射。
# xe_neutral.charge = 1 仅用于经电荷沉积获得中性密度场；中性化的壁面电荷
# 账目必须使用物理产物电荷 0。
# 环缝三面壁同属阳极: 离子在缝壁上按 slot_T (600 K) 中性化, 中性原子按
# slot_T 漫反射热化 (缝区壁面对中性气体全部反射, 保证净流量 = m_dot)。
xe_ions.analytic_wall.anode_ring.behaviors = convert
xe_ions.analytic_wall.anode_ring.product_species = xe_neutral
xe_ions.analytic_wall.anode_ring.wall_temperature = 400.0
xe_ions.analytic_wall.anode_ring.product_charge = 0.0
xe_ions.analytic_wall.anode_ring.deposit_wall_charge = 0
xe_ions.analytic_wall.ceramic_wall.behaviors = convert
xe_ions.analytic_wall.ceramic_wall.product_species = xe_neutral
xe_ions.analytic_wall.ceramic_wall.wall_temperature = 400.0
xe_ions.analytic_wall.ceramic_wall.product_charge = 0.0
xe_ions.analytic_wall.ceramic_wall.deposit_wall_charge = 0
xe_ions.analytic_wall.slot_bottom.behaviors = convert
xe_ions.analytic_wall.slot_bottom.product_species = xe_neutral
xe_ions.analytic_wall.slot_bottom.wall_temperature = 600.0
xe_ions.analytic_wall.slot_bottom.product_charge = 0.0
xe_ions.analytic_wall.slot_bottom.deposit_wall_charge = 0
xe_ions.analytic_wall.slot_inner_wall.behaviors = convert
xe_ions.analytic_wall.slot_inner_wall.product_species = xe_neutral
xe_ions.analytic_wall.slot_inner_wall.wall_temperature = 600.0
xe_ions.analytic_wall.slot_inner_wall.product_charge = 0.0
xe_ions.analytic_wall.slot_inner_wall.deposit_wall_charge = 0
xe_ions.analytic_wall.slot_outer_wall.behaviors = convert
xe_ions.analytic_wall.slot_outer_wall.product_species = xe_neutral
xe_ions.analytic_wall.slot_outer_wall.wall_temperature = 600.0
xe_ions.analytic_wall.slot_outer_wall.product_charge = 0.0
xe_ions.analytic_wall.slot_outer_wall.deposit_wall_charge = 0
xe_neutral.analytic_wall.anode_ring.behaviors = diffuse
xe_neutral.analytic_wall.anode_ring.wall_temperature = 400.0
xe_neutral.analytic_wall.anode_ring.deposit_wall_charge = 0
xe_neutral.analytic_wall.ceramic_wall.behaviors = diffuse
xe_neutral.analytic_wall.ceramic_wall.wall_temperature = 400.0
xe_neutral.analytic_wall.ceramic_wall.deposit_wall_charge = 0
xe_neutral.analytic_wall.slot_bottom.behaviors = diffuse
xe_neutral.analytic_wall.slot_bottom.wall_temperature = 600.0
xe_neutral.analytic_wall.slot_bottom.deposit_wall_charge = 0
xe_neutral.analytic_wall.slot_inner_wall.behaviors = diffuse
xe_neutral.analytic_wall.slot_inner_wall.wall_temperature = 600.0
xe_neutral.analytic_wall.slot_inner_wall.deposit_wall_charge = 0
xe_neutral.analytic_wall.slot_outer_wall.behaviors = diffuse
xe_neutral.analytic_wall.slot_outer_wall.wall_temperature = 600.0
xe_neutral.analytic_wall.slot_outer_wall.deposit_wall_charge = 0

