# AMR 阶段 7：Hall 两层静态网格联合输入。实施记录见 Source/Insert/Docs/AMRStage7.md。
# 工作目录为仓库内 <build>/bin，沿用主算例的 FILE 和数据相对路径。
# 生产 BP5 数据必须覆盖扩展域及外场插值 ghost；本输入尚待完整耦合运行验收。
FILE = ../../Script/PHT/3d_hall_dielectric_slot

# 扩展域独立于 lx/ly/lz；装置尺寸、注入位置、流量及宏粒子权重沿用主算例。
my_constants.amr_domain_xlo = -0.005
my_constants.amr_domain_ylo = -0.005
my_constants.amr_domain_zlo = -0.00875
my_constants.amr_domain_xhi = 0.015
my_constants.amr_domain_yhi = 0.015
my_constants.amr_domain_zhi = 0.01625
geometry.prob_lo = amr_domain_xlo amr_domain_ylo amr_domain_zlo
geometry.prob_hi = amr_domain_xhi amr_domain_yhi amr_domain_zhi

# level 0: dx = dy = dz = 78.125 um；level 1 恢复原算例 39.0625 um。
amr.n_cell = 256 256 320
amr.max_level = 1
amr.ref_ratio_vect = 2 2 2

# 细区覆盖原域，包括 z=8.4--9.2 mm 的阴极源和下游缓冲。
# 粗层半开索引 [64,192) x [64,192) x [80,240)。
# blocking_factor=32 使细层边界对齐；关闭默认 tag 膨胀以固定目标范围。
amr.blocking_factor = 32
amr.max_grid_size = 128
amr.n_error_buf = 0
warpx.fine_tag_lo = 0.0 0.0 -0.0025
warpx.fine_tag_hi = lx ly lz

# 只在初始化时建层。species ndt 仍由各物种的推进路径处理。
warpx.regrid_int = -1
warpx.do_subcycling = 0
algo.load_balance_intervals = 0

# 沿用主算例的 staggered 布局；其生产自力预算仍需验收，不能套用阶段 6
# collocated 小问题的结论或直接复制其缓冲宽度。
warpx.use_filter = 0
insert.ecdi_control.enabled = 0

# 显式选择第一类外边界；材料、二阶外推、MCC、墙面和文件磁场由主输入继承。
insert.electrostatic_boundary = dirichlet
insert.wall_charge_diagnostic = 1

# 诊断写到当前运行目录；出口统计若启用，对应扩展域的 z=16.25 mm。
ECDI_diag.file_prefix = diags/hall_amr
